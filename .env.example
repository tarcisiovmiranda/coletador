# Postgres (na Vercel use a URL com pooler em DATABASE_URL e a direta em DIRECT_URL)
DATABASE_URL="postgresql://user:pass@host:5432/coletador"
DIRECT_URL="postgresql://user:pass@host:5432/coletador"

# Segredo longo e aleatório: assina a sessão e é o "pepper" do hash dos códigos.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ATENÇÃO: trocar este valor invalida todos os códigos e sessões.
AUTH_SECRET=""

# Tenant padrão usado no login
TENANT_SLUG="fisp2026"

# Usados apenas pelo seed (admin inicial)
SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_CODIGO=""

# Cloudflare R2 (áudios dos leads). Sem estas variáveis o lead é salvo, mas sem áudio.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="coletador-audio"

# Leitura de crachá por foto (Claude). Sem esta chave o botão "Ler crachá" avisa que não está configurado.
ANTHROPIC_API_KEY=""
