generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Perfil {
  ADMIN
  COLETADOR
}

enum EtapaKanban {
  NOVO
  CONTATO
  REUNIAO
  PROPOSTA
  FECHADO
  PERDIDO
}

enum PixTipo {
  CPF
  CNPJ
  EMAIL
  PHONE
  EVP
}

enum PagamentoStatus {
  PROCESSANDO
  CONCLUIDO
  FALHOU
  VERIFICAR
}

enum ContratoStatus {
  PENDENTE
  APROVADO
  CANCELADO
}

model Tenant {
  id                 String              @id @default(cuid())
  slug               String              @unique
  nome               String
  // Comissão (%) aplicada sobre o valor de cada contrato novo
  comissaoPercentual Decimal             @default(0) @map("comissao_percentual") @db.Decimal(5, 2)
  createdAt          DateTime            @default(now())
  colaboradores      Colaborador[]
  leads              Lead[]
  contratos          Contrato[]
  pagamentos         PagamentoComissao[]
  modelosContrato    ModeloContrato[]
  assinaturas        AssinaturaContrato[]

  @@map("tenants")
}

model Colaborador {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  nome       String
  whatsapp   String?
  perfil     Perfil   @default(COLETADOR)
  // HMAC-SHA256 do código pessoal (nunca guardamos o código em claro)
  codigoHash String   @map("codigo_hash")
  // O mesmo código, cifrado (AES-256-GCM, chave derivada do AUTH_SECRET), só para o admin
  // rever e reenviar. Nulo nos colaboradores criados antes deste campo existir.
  codigoCifrado String? @map("codigo_cifrado")
  ativo      Boolean  @default(true)
  // Chave Pix para receber a comissão (só o admin cadastra)
  pixChave   String?  @map("pix_chave")
  pixTipo    PixTipo? @map("pix_tipo")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  leads      Lead[]
  contratos  Contrato[]
  pagamentos PagamentoComissao[]
  assinaturas AssinaturaContrato[]

  @@unique([tenantId, codigoHash])
  @@index([tenantId, perfil])
  @@map("colaboradores")
}

model Lead {
  id              String      @id @default(cuid())
  tenantId        String      @map("tenant_id")
  colaboradorId   String      @map("colaborador_id")
  nome            String
  cargo           String?
  empresa         String?
  inscricao       String?
  whatsapp        String?
  whatsappDdi     String      @default("55") @map("whatsapp_ddi")
  telefoneFixo    String?     @map("telefone_fixo")
  telefoneFixoDdi String?     @map("telefone_fixo_ddi")
  email           String?
  // Dados de credenciamento (formulário da feira)
  cpf             String?
  nomeCredencial  String?     @map("nome_credencial")
  sexo            String?
  dataNascimento  DateTime?   @map("data_nascimento") @db.Date
  cep             String?
  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  pais            String?
  uf              String?
  cidade          String?
  cnpj            String?
  etapaKanban     EtapaKanban @default(NOVO) @map("etapa_kanban")
  audioKey        String?     @map("audio_key")
  audioMime       String?     @map("audio_mime")
  // Gerado no aparelho: garante que reenviar o mesmo lead (rede instável) não duplica
  clientId        String?     @map("client_id")
  observacoes     String?
  // Preenchido pelo servidor (nunca pelo cliente)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])
  contrato    Contrato?
  assinaturas AssinaturaContrato[]

  @@unique([tenantId, clientId])
  @@index([tenantId, colaboradorId])
  @@index([tenantId, etapaKanban])
  @@map("leads")
}

model Contrato {
  id                      String         @id @default(cuid())
  tenantId                String         @map("tenant_id")
  leadId                  String         @unique @map("lead_id")
  colaboradorId           String         @map("colaborador_id")
  // Nome do colaborador no momento do contrato (histórico imutável)
  colaboradorNomeSnapshot String         @map("colaborador_nome_snapshot")
  plano                   String
  valor                   Decimal        @db.Decimal(12, 2)
  pagamento               String
  status                  ContratoStatus @default(PENDENTE)
  // Comissão calculada automaticamente a partir do percentual do tenant
  comissaoPercentual      Decimal?       @map("comissao_percentual") @db.Decimal(5, 2)
  comissaoValor           Decimal?       @map("comissao_valor") @db.Decimal(12, 2)
  // Aprovação interna pelo admin (o cliente não assina nada)
  aprovadoPorNome         String?        @map("aprovado_por_nome")
  aprovadoEm              DateTime?      @map("aprovado_em")
  // Pagamento da comissão (Pix) que quitou este contrato; null = ainda não pago
  pagamentoId             String?        @map("pagamento_id")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  lead              Lead               @relation(fields: [leadId], references: [id])
  colaborador       Colaborador        @relation(fields: [colaboradorId], references: [id])
  pagamentoComissao PagamentoComissao? @relation(fields: [pagamentoId], references: [id])

  @@index([tenantId, colaboradorId])
  @@index([tenantId, status])
  @@index([pagamentoId])
  @@map("contratos")
}

model PagamentoComissao {
  id                      String          @id @default(cuid())
  tenantId                String          @map("tenant_id")
  colaboradorId           String          @map("colaborador_id")
  colaboradorNomeSnapshot String          @map("colaborador_nome_snapshot")
  valor                   Decimal         @db.Decimal(12, 2)
  status                  PagamentoStatus @default(PROCESSANDO)
  // Chave usada no momento do pagamento (histórico imutável)
  pixChave                String          @map("pix_chave")
  pixTipo                 PixTipo         @map("pix_tipo")
  asaasTransferId         String?         @unique @map("asaas_transfer_id")
  comprovanteUrl          String?         @map("comprovante_url")
  erro                    String?
  criadoPorNome           String          @map("criado_por_nome")
  concluidoEm             DateTime?       @map("concluido_em")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  colaborador Colaborador @relation(fields: [colaboradorId], references: [id])
  contratos   Contrato[]

  @@index([tenantId, colaboradorId])
  @@index([tenantId, status])
  @@map("pagamentos_comissao")
}

model ModeloContrato {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  versao        Int
  titulo        String
  corpo         String
  criadoPorNome String?  @map("criado_por_nome")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  assinaturas AssinaturaContrato[]

  @@unique([tenantId, versao])
  @@map("modelos_contrato")
}

model AssinaturaContrato {
  id                  String   @id @default(cuid())
  tenantId            String   @map("tenant_id")
  leadId              String   @map("lead_id")
  modeloId            String   @map("modelo_id")
  colaboradorId       String   @map("colaborador_id")
  colaboradorNome     String   @map("colaborador_nome")
  textoFinal          String   @map("texto_final")
  campos              Json
  hashSha256          String   @map("hash_sha256")
  assinaturaKey       String   @map("assinatura_key")
  pdfKey              String   @map("pdf_key")
  signatarioNome      String   @map("signatario_nome")
  signatarioDocumento String   @map("signatario_documento")
  ip                  String
  userAgent           String   @map("user_agent")
  assinadoEm          DateTime @default(now()) @map("assinado_em")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  lead        Lead           @relation(fields: [leadId], references: [id])
  modelo      ModeloContrato @relation(fields: [modeloId], references: [id])
  colaborador Colaborador    @relation(fields: [colaboradorId], references: [id])

  @@index([tenantId, leadId])
  @@map("assinaturas_contrato")
}
